+    #[test]
+    fn wrix_launch_namespaces_session_fields_and_round_trips_runner_state() {
+        use std::os::unix::fs::PermissionsExt;
+
+        let mut cfg = sample_config(None);
+        cfg.model_id = Some("test-model".into());
+        cfg.shutdown_grace = Some(Duration::from_secs(5));
+        let mut rejected = Vec::new();
+        let scratch = [
+            std::env::current_dir().unwrap(),
+            std::fs::canonicalize("/tmp").unwrap(),
+        ]
+        .into_iter()
+        .find_map(|root| {
+            match crate::scratch::directory::Directory::open(&root) {
+                Ok(_) => Some(tempfile::tempdir_in(root).unwrap()),
+                Err(error) if error.kind() == std::io::ErrorKind::PermissionDenied => {
+                    rejected.push(error);
+                    None
+                }
+                Err(error) => panic!("cannot observe scratch ancestor: {error}"),
+            }
+        })
+        .unwrap_or_else(|| panic!("no trusted fixture ancestor: {rejected:?}"));
+        std::fs::set_permissions(scratch.path(), std::fs::Permissions::from_mode(0o700)).unwrap();
+        let file = crate::scratch::runtime::Config::write(scratch.path(), &cfg).unwrap();
+        let bytes = std::fs::read(file.path()).unwrap();
+        let value: serde_json::Value = serde_json::from_slice(&bytes).unwrap();
+        assert_eq!(
+            value
+                .as_object()
+                .unwrap()
+                .keys()
+                .map(String::as_str)
+                .collect::<Vec<_>>(),
+            [
+                "agent_args",
+                "env",
+                "extensions",
+                "image_ref",
+                "image_source",
+                "image_source_kind",
+                "workspace"
+            ]
+        );
+        assert_eq!(value["extensions"]["loom"]["initial_prompt"], "hello");
+        assert!(value["extensions"]["loom"].get("env").is_none());
+        let decoded = SpawnConfig::from_wrix_slice(&serde_json::to_vec(&value).unwrap()).unwrap();
+        assert_eq!(
+            serde_json::to_value(decoded).unwrap(),
+            serde_json::to_value(cfg).unwrap()
+        );
+    }

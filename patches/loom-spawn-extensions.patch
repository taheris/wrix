+impl SpawnConfig {
+    /// Encode Wrix launch inputs separately from opaque Loom session state.
+    ///
+    /// # Errors
+    /// Returns serialization errors without including credential values.
+    pub fn to_wrix_value(&self) -> Result<serde_json::Value, serde_json::Error> {
+        let mut payload = serde_json::to_value(self)?;
+        let mut launch = serde_json::Map::new();
+        for key in [
+            "image_ref",
+            "image_source",
+            "image_source_kind",
+            "workspace",
+            "env",
+            "agent_args",
+            "mounts",
+        ] {
+            if let Some(value) = payload.get_mut(key) {
+                launch.insert(key.to_owned(), value.take());
+            }
+            if let Some(object) = payload.as_object_mut() {
+                object.remove(key);
+            }
+        }
+        launch.insert(
+            "extensions".to_owned(),
+            serde_json::json!({"loom": payload}),
+        );
+        Ok(serde_json::Value::Object(launch))
+    }
+
+    /// Decode the namespaced session state from the immutable Wrix launch file.
+    ///
+    /// # Errors
+    /// Returns JSON or session-schema errors for incompatible launch files.
+    pub fn from_wrix_slice(bytes: &[u8]) -> Result<Self, serde_json::Error> {
+        #[derive(Deserialize)]
+        struct Launch {
+            #[serde(flatten)]
+            inputs: serde_json::Map<String, serde_json::Value>,
+            extensions: Extensions,
+        }
+        #[derive(Deserialize)]
+        struct Extensions {
+            loom: serde_json::Map<String, serde_json::Value>,
+        }
+        let launch: Launch = serde_json::from_slice(bytes)?;
+        let mut payload = launch.extensions.loom;
+        payload.extend(launch.inputs);
+        serde_json::from_value(serde_json::Value::Object(payload))
+    }
+}

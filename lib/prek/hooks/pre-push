#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=../binding.sh
source "${BASH_SOURCE[0]%/*}/_binding.sh"
wrix_prek_resolve

_worktree_root=$(git rev-parse --show-toplevel)
_wrix_dir="$_worktree_root/.wrix"
_stamp_file="$_wrix_dir/push-verified"
_head_sha=$(git rev-parse HEAD)
_remote_name="${1:-}"
_remote_location="${2:-}"
_stdin=$(cat)

# NUL delimiters keep every Git-supplied identity field unambiguous.
_approval_id="$(
    printf '%s\0' "wrix-push-verified-v1" "$_head_sha" "$_remote_name" "$_remote_location" "$_stdin" |
        git hash-object --stdin
)"

# A stamp is single-use even when it does not match this push transaction.
if [[ -f "$_stamp_file" ]]; then
    _stamped_approval_id="$(<"$_stamp_file")"
    rm -f "$_stamp_file"
    if [[ "$_stamped_approval_id" == "$_approval_id" ]]; then
        exit 0
    fi
fi

if [[ -z "$_stdin" ]]; then
    exit 0
fi

mkdir -p "$_wrix_dir"

# hook-impl parses Git's positional arguments and ref transaction; prek run does not.
_hook_dir="$(dirname "$0")"
printf '%s\n' "$_stdin" | prek hook-impl --hook-type=pre-push \
    --hook-dir "$_hook_dir" \
    --script-version 4 \
    -- "$@" || exit 1

printf '%s\n' "$_approval_id" > "$_stamp_file"
